# Optional AI provider credentials.
# Leave every value blank unless you use that provider. For browser-side
# connections, enter the credential in Settings -> AI; these keys are not
# automatically loaded by the client. Never add a VITE_ prefix: Vite bundles
# VITE_ variables into the public application.

# OpenRouter restricted API key (optional).
OPENROUTER_API_KEY=

# OpenAI project API key (optional).
OPENAI_API_KEY=

# NVIDIA NIM API key (optional).
NVIDIA_API_KEY=

# GitHub fine-grained token with models:read (optional).
GITHUB_TOKEN=

# Anthropic API key (optional).
ANTHROPIC_API_KEY=

# Google Gemini API key (optional).
GOOGLE_API_KEY=

# Optional bearer tokens for local OpenAI-compatible servers.
UNSLOTH_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Optional server-side fallback for the Pratt LLM provider.
# Browser-entered student keys take precedence and this value is never bundled.
PRATT_LLM_API_KEY=

# Explicit opt-in for the controlled internal Strudel demo publish path.
# Copy this file to .env, then set the literal value acknowledged.
UNDERSCORES_AGPL_COMPLIANCE=
