{
  "name": "drawerator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-excalidraw.js && vite",
    "build": "node scripts/patch-excalidraw.js && vite build",
    "build:single": "node scripts/patch-excalidraw.js && BUILD_SINGLE=true vite build",
    "deploy": "npm run build:single && gh-pages -d dist --dotfiles",
    "lint": "oxlint",
    "test": "node --test src/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@excalidraw/excalidraw": "^0.17.6",
    "@frankhommers/opencode-yolo": "^0.1.2",
    "@lezer/highlight": "^1.2.3",
    "jzz": "^1.9.6",
    "jzz-synth-tiny": "^1.4.4",
    "p5": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
