{
  "name": "drawerator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-excalidraw.js && vite",
    "build": "node scripts/patch-excalidraw.js && vite build",
    "build:single": "node scripts/patch-excalidraw.js && BUILD_SINGLE=true vite build",
    "deploy": "npm run build:single && gh-pages -d dist --dotfiles",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "vite": "^5.4.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
